# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs
ELEVEN_API_KEY=
ELEVEN_WEBHOOK_SECRET=
ELEVENLABS_TEMPLATE_AGENT_ID=

# Shared secret sent by ElevenLabs tool webhooks as the X-Tool-Secret header.
# When set, /tools/* requests without a matching header are rejected (401).
# Must also be added to each tool's request_headers in the ElevenLabs agent config.
TOOLS_WEBHOOK_SECRET=

# Twilio
ACCOUNT_SID=
AUTH_TOKEN=
PHONE_NUMBER=
# Optional shared SMS sender (e.g. verified toll-free). Unset → SMS goes from each shop's twilio_number.
TWILIO_SMS_FROM=

# Encryption (32-byte hex for AES-256-GCM)
ENCRYPTION_KEY=

# Admin
ADMIN_API_KEY=

# Google Calendar failure alerts to the team (E.164). Unset → alerts disabled.
TEAM_ALERT_PHONE=

# Worker
API_URL=
