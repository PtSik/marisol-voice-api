# Names must match WorkerBindings in src/types.ts exactly — this file is the .dev.vars template
# for `wrangler dev`. In production the [vars] block lives in wrangler.toml and everything else is
# set with `wrangler secret put <NAME>`.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=
# Legacy template configuration. Inbound calls require shops.elevenlabs_agent_id;
# the landing worker pins BARBER_AGENT_ID / GROOMING_AGENT_ID per shop.
ELEVENLABS_TEMPLATE_AGENT_ID=

# Shared secret sent by ElevenLabs tool webhooks as the X-Tool-Secret header.
# Missing configuration rejects /tools/* requests (503); a wrong header returns 401.
# Must also be added to each tool's request_headers in the agent config.
TOOLS_WEBHOOK_SECRET=

# ── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional shared SMS sender (e.g. a verified toll-free number).
# Unset → each shop sends from its own twilio_number.
TWILIO_SMS_FROM=
# Deployment-wide launch gate. Every SMS is blocked unless this is exactly "true".
# Keep false until the US A2P brand and campaign are approved and deliverability is tested.
SMS_ENABLED=false

# ── Encryption ───────────────────────────────────────────────────────────────
# 32-byte hex for AES-256-GCM. Must match the landing repo's value — it encrypts the same blob.
ENCRYPTION_KEY=

# ── Admin API ────────────────────────────────────────────────────────────────
# Comma-separated bearer tokens. Also the HMAC key that signs calendar-connect links,
# so the landing worker's ADMIN_API_KEY must be one of these.
ADMIN_API_KEYS=
# Optional comma-separated IPs, checked against CF-Connecting-IP.
ADMIN_IP_ALLOWLIST=

# ── Google Calendar OAuth (GCP project marisol-voice, External) ───────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Team alerts ──────────────────────────────────────────────────────────────
# Discord incoming-webhook URL for calendar failure alerts. Unset disables alerting entirely.
DISCORD_ALERT_WEBHOOK_URL=

# ── Misc ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Where the calendar picker returns the customer. Must be https or the return link is suppressed.
PORTAL_URL=https://app.callmarisol.com/portal/calendar
